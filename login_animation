<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Animated Lamp Login</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: #080b10;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow: hidden;
    }

    /* Ambient Background Light overlay */
    .bg-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: radial-gradient(circle at 50% 30%, rgba(0, 255, 170, 0.12), transparent 70%);
      opacity: 0;
      transition: opacity 0.5s ease;
      pointer-events: none;
    }

    /* Outer Wrapper for Lamp + Card positioning */
    .card-wrapper {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Interactive Pull Cord Lamp */
    .lamp-container {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
      z-index: 10;
    }

    .lamp-wire {
      width: 2px;
      height: 40px;
      background: #333;
    }

    .lamp-head {
      width: 60px;
      height: 35px;
      background: #222;
      border-radius: 30px 30px 0 0;
      position: relative;
    }

    .lamp-light-bulb {
      width: 24px;
      height: 24px;
      background: #444;
      border-radius: 50%;
      margin: -10px auto 0;
      transition: background 0.4s ease, box-shadow 0.4s ease;
    }

    /* Pull String Handle */
    .pull-cord {
      position: absolute;
      top: 35px;
      right: -15px;
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: transform 0.15s ease-out;
    }

    .cord-line {
      width: 2px;
      height: 45px;
      background: #666;
    }

    .cord-knob {
      width: 8px;
      height: 12px;
      background: #888;
      border-radius: 4px;
    }

    .pull-cord:active {
      transform: translateY(12px);
    }

    /* Light Beam Cone */
    .light-beam {
      position: absolute;
      top: 65px;
      width: 0;
      height: 0;
      border-left: 180px solid transparent;
      border-right: 180px solid transparent;
      border-bottom: 420px solid rgba(0, 255, 170, 0.15);
      opacity: 0;
      transition: opacity 0.5s ease;
      pointer-events: none;
      filter: blur(8px);
    }

    /* Character Mascot */
    .mascot {
      width: 80px;
      height: 80px;
      background: #00ffaa;
      border-radius: 50%;
      margin: 10px auto 15px;
      box-shadow: 0 0 25px rgba(0, 255, 170, 0.6);
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      opacity: 0;
      transform: scale(0.5);
      transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .mascot-face {
      width: 50px;
      height: 30px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
    }

    .eyes {
      display: flex;
      gap: 16px;
    }

    .eye {
      width: 8px;
      height: 8px;
      background: #0d1117;
      border-radius: 50%;
    }

    .mouth {
      width: 20px;
      height: 10px;
      border-bottom: 3px solid #0d1117;
      border-radius: 0 0 10px 10px;
    }

    /* Main Login Container */
    .login-container {
      text-align: center;
      padding: 30px 40px 40px;
      background: #0d1117;
      border-radius: 20px;
      width: 340px;
      color: #fff;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.6s ease, transform 0.6s ease;
      z-index: 5;
      border: 1px solid #161b22;
    }

    .instruction-text {
      font-size: 12px;
      color: #8b949e;
      margin-bottom: 12px;
    }

    h2 {
      font-size: 22px;
      margin-bottom: 20px;
    }

    .input-group {
      text-align: left;
      margin-bottom: 15px;
    }

    .input-group label {
      display: block;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #8b949e;
      margin-bottom: 6px;
    }

    input {
      width: 100%;
      padding: 12px;
      border: 1px solid #30363d;
      border-radius: 8px;
      background: #161b22;
      color: #fff;
      outline: none;
      transition: border-color 0.3s;
    }

    input:focus {
      border-color: #00ffaa;
    }

    button.sign-in-btn {
      width: 100%;
      padding: 12px;
      margin-top: 10px;
      background: linear-gradient(90deg, #00ffaa, #00b894);
      border: none;
      color: #0d1117;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    button.sign-in-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 255, 170, 0.4);
    }

    /* Social Login Buttons */
    .divider {
      margin: 20px 0;
      display: flex;
      align-items: center;
      color: #484f58;
      font-size: 12px;
    }

    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #21262d;
    }

    .social-btn-container {
      display: flex;
      gap: 12px;
    }

    .social-btn {
      flex: 1;
      padding: 8px;
      background: #161b22;
      border: 1px solid #30363d;
      border-radius: 8px;
      color: #c9d1d9;
      cursor: pointer;
      font-size: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: background 0.2s;
    }

    .social-btn:hover {
      background: #21262d;
    }

    /* --- ACTIVE STATE (LIGHT ON) --- */
    body.light-on .bg-overlay {
      opacity: 1;
    }

    body.light-on .lamp-light-bulb {
      background: #00ffaa;
      box-shadow: 0 0 25px #00ffaa, 0 0 50px #00ffaa;
    }

    body.light-on .light-beam {
      opacity: 1;
    }

    body.light-on .mascot {
      opacity: 1;
      transform: scale(1);
    }

    body.light-on .login-container {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>

  <div class="bg-overlay"></div>

  <div class="card-wrapper">
    <!-- Interactive Lamp -->
    <div class="lamp-container" id="lamp">
      <div class="lamp-wire"></div>
      <div class="lamp-head">
        <div class="lamp-light-bulb"></div>
        <div class="pull-cord">
          <div class="cord-line"></div>
          <div class="cord-knob"></div>
        </div>
      </div>
      <div class="light-beam"></div>
    </div>

    <!-- Login Box -->
    <div class="login-container">
      <div class="mascot">
        <div class="mascot-face">
          <div class="eyes">
            <div class="eye"></div>
            <div class="eye"></div>
          </div>
          <div class="mouth"></div>
        </div>
      </div>

      <h2>Welcome Back.</h2>
      <p class="instruction-text">Pull the cord to illuminate your path</p>

      <div class="input-group">
        <label>Username</label>
        <input type="text" placeholder="Enter username">
      </div>

      <div class="input-group">
        <label>Password</label>
        <input type="password" placeholder="••••••••">
      </div>

      <button class="sign-in-btn">SIGN IN &rarr;</button>

      <div class="divider"></div>

      <div class="social-btn-container">
        <button class="social-btn">Google</button>
        <button class="social-btn">GitHub</button>
      </div>
    </div>
  </div>

  <script>
  const lamp = document.getElementById('lamp');

  // Toggle light function
  function toggleLamp() {
    document.body.classList.toggle('light-on');
  }

  // Allow manual clicking anytime
  lamp.addEventListener('click', toggleLamp);

  // Automatically trigger the animation on page load after a brief delay
  window.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      // Add a slight pull animation effect to the cord before toggling
      const cord = document.querySelector('.pull-cord');
      cord.style.transform = 'translateY(12px)';

      setTimeout(() => {
        cord.style.transform = 'translateY(0)';
        toggleLamp(); // Turn light ON automatically
      }, 200);

    }, 500); // 500ms delay after load
  });
</script>
</body>
</html>
